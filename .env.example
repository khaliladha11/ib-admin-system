# Salin menjadi .env lalu sesuaikan. Jangan simpan rahasia di repo.

# Port server API (apps/server)
PORT=3000

# Alamat server yang dituju proxy /api saat `pnpm dev` (apps/web)
VITE_API_PROXY_TARGET=http://localhost:3000

# Lokasi file database SQLite, relatif terhadap apps/server
DATABASE_URL=data/ib.sqlite

# Cookie sesi hanya lewat HTTPS (bawaan: true bila NODE_ENV=production)
# COOKIE_SECURE=false

# Lama sesi login dalam hari
SESSION_TTL_DAYS=30

# Isi QR label ternak (apps/web). Kosong: QR hanya berisi kode IB-XXXXX.
# Diisi: QR berisi URL https://domain/t/IB-XXXXX (tetap tanpa nama atau data pribadi).
# VITE_QR_BASE_URL=https://ib.contoh.test

# --- Pos IB (langkah 4.3, docs/INSTALL.md). Dipakai docker-compose.yml; dibuat scripts/install.sh ---
# Alamat IP komputer pos yang dibuka HP (sertifikat HTTPS dibuat untuk alamat ini)
# POS_HOST=192.168.1.10
# Akun admin dinas pertama (hanya dipakai bila database masih kosong; password ≥ 8 karakter)
# ADMIN_NAME=Admin pos IB
# ADMIN_EMAIL=admin@pos-ib.lokal
# ADMIN_PASSWORD=
# REGION_NAME=Pos IB Kecamatan Contoh
# Isi data contoh fiktif bila database kosong (untuk mencoba)
# DEMO_DATA=0
# Cadangan harian SQLite (folder relatif terhadap apps/server, simpan N terakhir)
# BACKUP_DIR=backups
# BACKUP_KEEP=14
# BACKUP_DISABLED=0
# Alamat aplikasi & sertifikat yang ditampilkan di halaman Pos IB (compose mengisinya dari POS_HOST)
# PUBLIC_URL=https://192.168.1.10
# CERT_URL=http://192.168.1.10/sertifikat
# Server menyajikan build web dari origin yang sama (diisi di image Docker)
# WEB_DIST=../web/dist
# HOST=0.0.0.0
